# Use long, unique values. For the bundled Compose setup, keep the DB password URL-safe.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
JWT_SECRET=replace_with_a_long_random_signing_secret_at_least_32_chars
ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# Keep false in production unless public API docs are intentional.
ENABLE_API_DOCS=false
APP_ENV=production

# Optional: set both to create the first administrator at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sentence-transformer model; downloaded and cached on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
